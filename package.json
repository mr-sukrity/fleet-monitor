{
  "name": "fleet-monitor",
  "version": "1.0.0",
  "description": "Tracks heartbeats from a fleet of devices and reports which ones are online.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "simulate": "node simulator/simulator.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  }
}
